# Local-only secrets (this file is gitignored)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# OpenAI Models (optional, defaults in code)
# Main conversation/response model (must support web_search and tool calling)
OPENAI_RESPONSES_MODEL=gpt-5-mini

# Camera vision analysis model
OPENAI_CAMERA_MODEL=gpt-5-mini

# Memory extraction model
OPENAI_MEMORY_MODEL=gpt-5-mini

# Image generation model
OPENAI_IMAGE_MODEL=gpt-image-1.5

# ElevenLabs TTS (optional, defaults in code)
# Quality mode (default): Uses eleven_v3 with emotional audio tags
# Fast mode: Uses eleven_flash_v2_5 (audio tags stripped, faster responses)
ELEVEN_TTS_MODEL=eleven_v3

# Identity service (profiles + memory + saved images)
# Used in the browser (Next.js public env):
NEXT_PUBLIC_IDENTITY_SERVICE_URL=http://localhost:5176
# Used on the server (Next.js API routes):
IDENTITY_SERVICE_URL=http://localhost:5176

# Prompt mode (optional, default: compact)
# Options: compact | verbose
AMBIT_PROMPT_MODE=compact

# Face API model base URL (optional)
# NEXT_PUBLIC_FACEAPI_MODEL_BASE_URL=https://your-cdn.com/faceapi-models
