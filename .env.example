OPENAI_API_KEY=

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional (defaults in code): ELEVEN_TTS_MODEL=eleven_v3
# Note: Eleven v3 supports audio tags like [laughs] / [short pause].

# Google Calendar (OAuth)
# Create OAuth credentials in Google Cloud Console (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: if unset, Ambit derives redirect URL from the request origin.
# Example (dev): http://localhost:3000/api/google_calendar/callback
GOOGLE_OAUTH_REDIRECT_URL=

# Identity service (profiles + memory + saved images)
# Used in the browser (Next.js public env):
NEXT_PUBLIC_IDENTITY_SERVICE_URL=http://localhost:5176
# Used on the server (Next.js API routes):
IDENTITY_SERVICE_URL=http://localhost:5176

